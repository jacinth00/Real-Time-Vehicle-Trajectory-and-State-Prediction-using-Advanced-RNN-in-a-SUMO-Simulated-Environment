<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <input>
        <net-file value="hybrid_network.net.xml"/>
        <route-files value="hybrid_routes.rou.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="300"/>
        <step-length value="1.0"/>
    </time>
    <report>
        <verbose value="true"/>
        <duration-log.disable value="false"/>
    </report>
</configuration>
